{
  "name": "cf-waf-sync",
  "version": "1.0.0",
  "description": "Cloudflare Worker (TypeScript) cron that syncs sefinek/Cloudflare-WAF-Expressions WAF custom rules + IP blocklist (SniffCat + AbuseIPDB) — 4x daily, WAF does the blocking",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle": "tsx scripts/bundle.ts",
    "lint:commits": "commitlint --from=origin/main --to=HEAD --verbose"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260916.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "semantic-release": "^24.2.8",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.132.0"
  },
  "dependencies": {
    "p-limit": "^6.2.0",
    "zod": "^3.25.0"
  }
}
